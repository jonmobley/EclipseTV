<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Moxie LLC. All rights reserved.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
            <key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>External Display</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).ExternalSceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Eclipse needs access to the local network to connect with your Apple TV</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_eclipse-share._tcp</string>
        <string>_eclipse-share._udp</string>
    </array>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Eclipse needs access to your photos to send them to your Apple TV</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Eclipse saves camera photos and videos to your Photos library</string>
    <key>NSCameraUsageDescription</key>
    <string>Eclipse needs camera access to present a live camera feed on your TV via AirPlay</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Eclipse needs microphone access to record video with sound</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>