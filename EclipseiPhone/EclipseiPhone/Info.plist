<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Moxie LLC. All rights reserved.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
            <key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>External Display</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).ExternalSceneDelegate</string>
                </dict>
            </array>
            <key>UIWindowSceneSessionRoleExternalDisplay</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>External Display</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).ExternalSceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.mobleypro.eclipse.mac-remote</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>eclipse</string>
            </array>
        </dict>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Alone on purpose: NSAllowsLocalNetworking makes iOS ignore
             NSAllowsArbitraryLoads, which breaks Phone Camera on hotspot
             addresses outside RFC1918 (e.g. 192.0.0.2). -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Eclipse needs access to the local network to connect with your Apple TV, Eclipse on your Mac, and Phone Camera ingest</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_eclipse-share._tcp</string>
		<string>_eclipse-share._udp</string>
		<string>_eclipsephone._tcp</string>
	</array>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Eclipse needs access to your photos to send them to your Apple TV</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Eclipse saves camera photos and videos to your Photos library</string>
	<key>NSCameraUsageDescription</key>
	<string>Eclipse needs camera access for live camera on AirPlay, Send Camera to Mac, and to scan pairing QR codes</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Eclipse needs microphone access to record video with sound</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>remote-notification</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>